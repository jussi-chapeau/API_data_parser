{
  "name": "Reference Data Sync (hubs weekly)",
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "aaaaaaaa-0005-0005-0005-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "aaaaaaaa-0005-0005-0005-000000000002",
      "name": "Fetch Hubs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://qtml5qv6uk.execute-api.eu-central-1.amazonaws.com/production/hub",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "oz6Dcgxn5k3px6a3fN9NU5YHshMuYpxP4NNyMdi4"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "aaaaaaaa-0005-0005-0005-000000000003",
      "name": "Transform Hubs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const d = item.json;\n\n  const transformed = {\n    hub_id: d.hubId,\n    hub_name: d.hubName || null,\n    opening_hours: d.openingHours !== undefined ? d.openingHours : null,\n    hub_location: d.hubLocation !== undefined ? d.hubLocation : null,\n    service_info: d.serviceInfo !== undefined ? d.serviceInfo : null,\n    tz: d.tz || null,\n    synced_at: new Date().toISOString()\n  };\n\n  if (transformed.hub_id) {\n    results.push({ json: transformed });\n  }\n}\n\nreturn results;"
      }
    },
    {
      "id": "aaaaaaaa-0005-0005-0005-000000000004",
      "name": "Upsert Hubs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ybznbfezrdgzgptxkgul.supabase.co/rest/v1/hubs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUPABASE_SERVICE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer SUPABASE_SERVICE_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $input.all().map(i => i.json) }}",
        "options": {}
      }
    },
    {
      "id": "aaaaaaaa-0005-0005-0005-000000000005",
      "name": "Log Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ybznbfezrdgzgptxkgul.supabase.co/rest/v1/sync_log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUPABASE_SERVICE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer SUPABASE_SERVICE_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([{ workflow: 'reference-sync', started_at: $execution.startedAt, completed_at: new Date().toISOString(), date_range: 'full', rows_upserted: $('Transform Hubs').all().length, status: 'success', error_message: null }]) }}",
        "options": {}
      }
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "reference-sync",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "88b7948f-0803-4e06-86de-cf948eab3965",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        480
      ],
      "webhookId": "88b7948f-0803-4e06-86de-cf948eab3965"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch Hubs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Hubs": {
      "main": [
        [
          {
            "node": "Transform Hubs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform Hubs": {
      "main": [
        [
          {
            "node": "Upsert Hubs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upsert Hubs": {
      "main": [
        [
          {
            "node": "Log Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Fetch Hubs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
