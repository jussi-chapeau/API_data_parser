{
  "name": "Data Freshness Watchdog",
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false,
    "errorWorkflow": "6hIScmlYADgaf16s"
  },
  "nodes": [
    {
      "id": "fa000000-0000-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "fa000000-0000-4000-8000-000000000002",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        480
      ],
      "webhookId": "fa000000-0000-4000-8000-000000000002",
      "parameters": {
        "httpMethod": "POST",
        "path": "data-freshness-check",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "fa000000-0000-4000-8000-000000000003",
      "name": "Query Freshness",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        470,
        380
      ],
      "parameters": {
        "method": "GET",
        "url": "https://ybznbfezrdgzgptxkgul.supabase.co/rest/v1/analytics_freshness?select=*",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUPABASE_SERVICE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer SUPABASE_SERVICE_KEY"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "fa000000-0000-4000-8000-000000000004",
      "name": "Evaluate Staleness",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        380
      ],
      "parameters": {
        "jsCode": "// Data-freshness watchdog.\n//\n// Keyed on MAX(date) -- how recent the DATA is -- NOT MAX(synced_at). That distinction is\n// the entire reason the GA4 outage ran five weeks unnoticed: the Supermetrics job kept\n// succeeding nightly and re-stamping synced_at on old rows, so every synced_at-based signal\n// reported \"fresh\" while the newest actual data was 35 days old. An alarm wired to the job's\n// own success, or to when it last touched a row, cannot see this class of failure at all.\n//\n// Thresholds are per-feed because the cadences differ. Each feed lands roughly daily, so\n// \"yesterday\" is normal; a few days is a wobble; a week is broken.\nconst rows = $input.all().map((i) => i.json);\n\nconst THRESHOLD_DAYS = {\n  analytics_ga_daily_totals: 3,\n  ads_google_campaign_daily: 3,\n  ads_meta_placement_daily: 3,\n};\nconst DEFAULT_THRESHOLD = 3;\n\nconst stale = rows.filter((r) => {\n  const limit = THRESHOLD_DAYS[r.feed] ?? DEFAULT_THRESHOLD;\n  return r.data_age_days === null || r.data_age_days > limit;\n});\n\n// Emit one item either way so the IF node always has something to branch on; a watchdog\n// that silently emits nothing when the query misbehaves is the same failure it exists to catch.\nreturn [{\n  json: {\n    checked: rows.length,\n    stale_count: stale.length,\n    stale,\n    summary: stale.map((s) =>\n      `• *${s.feed}* — data ends ${s.data_through} (${s.data_age_days}d old` +\n      (s.false_freshness_days > 0\n        ? `, but last touched ${s.last_touched} — a synced_at alarm would say \"fresh\")`\n        : ')')\n    ).join('\\n'),\n  },\n}];\n"
      }
    },
    {
      "id": "fa000000-0000-4000-8000-000000000005",
      "name": "Anything Stale?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        930,
        380
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": "={{ $json.stale_count }}",
              "rightValue": 0
            }
          ]
        }
      }
    },
    {
      "id": "fa000000-0000-4000-8000-000000000006",
      "name": "Send Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1170,
        280
      ],
      "credentials": {
        "slackApi": {
          "id": "GutThvCLCxxw08G3",
          "name": "Slack account 2"
        }
      },
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "tech-alerts-sos",
          "mode": "name"
        },
        "text": "=⚠️ *Marketing/analytics data is stale*\n\n{{ $json.summary }}\n\nChecked {{ $json.checked }} feeds, {{ $json.stale_count }} stale.\n_Measured on MAX(date) — how recent the data is — not on whether the sync job reported success._",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Query Freshness",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Query Freshness",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Freshness": {
      "main": [
        [
          {
            "node": "Evaluate Staleness",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Staleness": {
      "main": [
        [
          {
            "node": "Anything Stale?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anything Stale?": {
      "main": [
        [
          {
            "node": "Send Alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  }
}