{
  "name": "Ads Google Daily Sync (last 30 days)",
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "aaaaaaaa-0009-0009-0009-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 5 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "aaaaaaaa-0009-0009-0009-000000000002",
      "name": "Fetch Google Ads Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.supermetrics.com/enterprise/v2/query/data/keyjson",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ds_id: 'AW', ds_accounts: 'list.all_accounts', ds_user: 'jussi@apukuski.com', date_range_type: 'last_30_days', fields: 'Date,CampaignID,Campaignname,Impressions,Clicks,Cost_eur,ConversionValue,Conversions', max_rows: 5000 }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_SUPERMETRICS_CREDENTIAL_ID",
          "name": "Supermetrics API"
        }
      }
    },
    {
      "id": "aaaaaaaa-0009-0009-0009-000000000003",
      "name": "Transform Ads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "jsCode": "// NOTE: assumes the /keyjson endpoint returns a bare array of row objects and that\n// n8n's HTTP Request node auto-splits that top-level array into one item per row\n// (same behavior already relied on by Transform Hubs in reference-sync.json for the\n// Backoffice /hub array). On first real run, confirm the item count here matches the\n// row count Supermetrics reported in the Hub preview. If it instead comes through as a\n// single item wrapping the whole array, change this to iterate\n// $input.first().json directly instead of $input.all().\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const d = item.json;\n\n  const transformed = {\n    date: d.Date,\n    campaign_id: d.CampaignID,\n    campaign_name: d.Campaignname || null,\n    impressions: d.Impressions != null ? Number(d.Impressions) : null,\n    clicks: d.Clicks != null ? Number(d.Clicks) : null,\n    cost_eur: d.Cost_eur != null ? Number(d.Cost_eur) : null,\n    conversions: d.Conversions != null ? Number(d.Conversions) : null,\n    conversion_value: d.ConversionValue != null ? Number(d.ConversionValue) : null,\n    synced_at: new Date().toISOString()\n  };\n\n  if (transformed.date && transformed.campaign_id) {\n    results.push({ json: transformed });\n  }\n}\n\nreturn results;"
      }
    },
    {
      "id": "aaaaaaaa-0009-0009-0009-000000000004",
      "name": "Upsert Ads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "parameters": {
        "method": "POST",
        "url": "https://ybznbfezrdgzgptxkgul.supabase.co/rest/v1/ads_google_campaign_daily",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUPABASE_SERVICE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer SUPABASE_SERVICE_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $input.all().map(i => i.json) }}",
        "options": {}
      }
    },
    {
      "id": "aaaaaaaa-0009-0009-0009-000000000005",
      "name": "Log Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "https://ybznbfezrdgzgptxkgul.supabase.co/rest/v1/sync_log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUPABASE_SERVICE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer SUPABASE_SERVICE_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([{ workflow: 'ads-google-daily', started_at: $execution.startedAt, completed_at: new Date().toISOString(), date_range: 'last_30_days', rows_upserted: $('Transform Ads').all().length, status: 'success', error_message: null }]) }}",
        "options": {}
      }
    },
    {
      "id": "88b7948f-0803-4e06-86de-cf948eab3971",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 480],
      "parameters": {
        "httpMethod": "POST",
        "path": "ads-google-daily",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "88b7948f-0803-4e06-86de-cf948eab3971"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Fetch Google Ads Data", "type": "main", "index": 0 }]]
    },
    "Fetch Google Ads Data": {
      "main": [[{ "node": "Transform Ads", "type": "main", "index": 0 }]]
    },
    "Transform Ads": {
      "main": [[{ "node": "Upsert Ads", "type": "main", "index": 0 }]]
    },
    "Upsert Ads": {
      "main": [[{ "node": "Log Sync", "type": "main", "index": 0 }]]
    },
    "Webhook Trigger": {
      "main": [[{ "node": "Fetch Google Ads Data", "type": "main", "index": 0 }]]
    }
  }
}
