    {
      "id": "aaaaaaaa-0006-0006-0006-000000000003",
      "name": "Split Into 30-Day Chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "jsCode": "const { fromDate, toDate } = $input.first().json;\n\nconst chunks = [];\nlet current = new Date(fromDate);\nconst end = new Date(toDate);\n\nwhile (current < end) {\n  const chunkFrom = current.toISOString().split('T')[0];\n  const chunkToTs = new Date(current.getTime() + 30 * 24 * 60 * 60 * 1000 - 1);\n  const chunkTo = (chunkToTs > end ? end : chunkToTs).toISOString().split('T')[0];\n  chunks.push({ json: { chunkFrom, chunkTo } });\n  current = new Date(current.getTime() + 30 * 24 * 60 * 60 * 1000);\n}\n\nreturn chunks;"
      }
    },
