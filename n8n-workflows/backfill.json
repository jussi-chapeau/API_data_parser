      "position": [1120, 440],
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const d = item.json;\n\n  const transformed = {\n    route_id: d.routeId,\n    date: d.date || null,\n    hub_id: d.hubId || null,\n    partner: d.partner || null,\n    internal_cost: d.internalCost !== undefined && d.internalCost !== null ? Math.round(parseFloat(d.internalCost)) : null,\n    order_ids: d.orderIds !== undefined ? d.orderIds : null,\n    warehouse_order_ids: d.warehouseOrderIds !== undefined ? d.warehouseOrderIds : null,\n    total_sales: d.totalSales !== undefined && d.totalSales !== null ? parseFloat(d.totalSales) : null,\n    synced_at: new Date().toISOString()\n  };\n\n  if (transformed.route_id) {\n    results.push({ json: transformed });\n  }\n}\n\nreturn results;"
