      "position": [460, 300],
      "parameters": {
        "jsCode": "const fromDate = '2024-01-01';\nconst toDate = new Date(Date.now() - 46 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];\nreturn [{ json: { fromDate, toDate } }];"
      }
