      "name": "Transform Orders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 230],
      "parameters": {
        "jsCode": "function tsToIso(val) {\n  if (val === null || val === undefined || val === '') return null;\n  const n = parseFloat(val);\n  if (isNaN(n)) return null;\n  return new Date(n * 1000).toISOString();\n}\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const d = item.json;\n\n  const isManual = d.isManual === true || d.isManual === 'true' || (d.customer !== undefined && d.additionalInfo !== undefined);\n\n  const transformed = {\n    order_id: d.orderId,\n    is_manual: isManual,\n    created_at: tsToIso(d.createdAt),\n    organization_name: d.organizationName || null,\n    org_id: d.orgId || null,\n    hub_id: d.hubId || null,\n    order_state: d.orderState || null,\n    order_type: d.orderType || null,\n    first_schedule: tsToIso(d.firstSchedule),\n    schedule: d.schedule || null,\n    content: d.content || null,\n    stops: d.stops || null,\n    charge: d.charge || null,\n    platform_fee: d.platformFee !== undefined && d.platformFee !== null ? Math.round(parseFloat(d.platformFee)) : null,\n    service_fee: d.serviceFee !== undefined && d.serviceFee !== null ? Math.round(parseFloat(d.serviceFee)) : null,\n    route_id: d.routeId || null,\n    commission_rate: d.commissionRate !== undefined ? parseFloat(d.commissionRate) : null,\n    underway_at: tsToIso(d.underwayAt),\n    in_transit_at: tsToIso(d.inTransitAt),\n    delivered_at: tsToIso(d.deliveredAt),\n    review: d.review || null,\n    manual_data: isManual ? { customer: d.customer || null, additionalInfo: d.additionalInfo || null, serviceFeeApplied: d.serviceFeeApplied || null } : null,\n    synced_at: new Date().toISOString()\n  };\n\n  if (transformed.order_id) {\n    results.push({ json: transformed });\n  }\n}\n\nreturn results;"
      }
    },
    {
      "id": "aaaaaaaa-0006-0006-0006-000000000009",
