{
  "name": "Supabase Health Check",
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "nodes": [
    {
      "id": "hc-schedule-01",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "hc-ping-01",
      "name": "Ping Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "continueOnFail": true,
      "parameters": {
        "method": "GET",
        "url": "https://ybznbfezrdgzgptxkgul.supabase.co/rest/v1/sync_log?select=id&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUPABASE_SERVICE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer SUPABASE_SERVICE_KEY"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "hc-if-01",
      "name": "Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-01",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "id": "hc-slack-01",
      "name": "Send Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        720,
        200
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "tech-alerts-sos",
          "mode": "name"
        },
        "text": "=\ud83d\udea8 *Supabase Health Check FAILED*\n\n\ud83d\udccc *Error:* {{ $json.error?.message || 'Unreachable' }}\n\ud83d\udd50 *Time:* {{ new Date().toISOString() }}\n\nSupabase REST API at `ybznbfezrdgzgptxkgul` is not responding.",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "credentials": {
        "slackApi": {
          "id": "GutThvCLCxxw08G3",
          "name": "Slack account 2"
        }
      }
    },
    {
      "id": "hc-log-01",
      "name": "Log Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ybznbfezrdgzgptxkgul.supabase.co/rest/v1/sync_log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "SUPABASE_SERVICE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer SUPABASE_SERVICE_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "[{ \"workflow\": \"supabase-health-check\", \"started_at\": \"={{ $execution.startedAt }}\", \"completed_at\": \"={{ new Date().toISOString() }}\", \"date_range\": null, \"rows_upserted\": 0, \"status\": \"error\", \"error_message\": \"={{ $json.error?.message || 'Supabase unreachable' }}\" }]",
        "options": {}
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Ping Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ping Supabase": {
      "main": [
        [
          {
            "node": "Healthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Healthy?": {
      "main": [
        [
          {
            "node": "Send Alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Send Alert": {
      "main": [
        [
          {
            "node": "Log Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
