    {
      "id": "aaaaaaaa-0011-0011-0011-000000000004",
      "name": "Transform GA Totals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        200
      ],
      "parameters": {
        "jsCode": "// Chunks into one OUTPUT ITEM per 100-row batch. The downstream Upsert node references\n// $json (the current item), not $input.all() -- so n8n's default per-item node execution\n// naturally sends one POST per batch instead of one giant unbatched request. This is what\n// crashed the previous version (NodeCrashedError, likely OOM sending up to 11,350 rows in a\n// single POST -- same class of problem docs/project-architecture.md already documents for\n// orders-cool.json). No loop node, no Code-node credential/helper APIs needed -- this only\n// uses $input.first() and return [...], the most basic Code-node capabilities.\n//\n// Also confirmed live: this.getCredentials() does NOT exist in this n8n instance's Code-node\n// sandbox (JS Task Runner architecture) -- credentialed calls must go through native nodes.\n\nfunction serialToISODate(serial) {\n  const epochMs = Date.UTC(1899, 11, 30);\n  return new Date(epochMs + serial * 86400000).toISOString().slice(0, 10);\n}\n\nconst resp = $input.first().json;\nconst rows = (resp.values || []).slice(1); // skip header row\nconst transformed = [];\n\nfor (const r0 of rows) {\n  const r = r0.map(v => v === '' ? null : v);\n  const [dateSerial, sessions, totalUsers, newUsers, views, viewsPerSession, bounceRate, avgSessionLengthSec, conversions, userConversionRate] = r;\n  if (dateSerial == null) continue;\n  transformed.push({\n    date: serialToISODate(dateSerial),\n    sessions: sessions ?? null,\n    total_users: totalUsers ?? null,\n    new_users: newUsers ?? null,\n    views: views ?? null,\n    views_per_session: viewsPerSession ?? null,\n    bounce_rate: bounceRate ?? null,\n    avg_session_length_sec: avgSessionLengthSec ?? null,\n    conversions: conversions ?? null,\n    user_conversion_rate: userConversionRate ?? null,\n    synced_at: new Date().toISOString(),\n  });\n}\n\nconst BATCH = 100;\nconst results = [];\nfor (let i = 0; i < transformed.length; i += BATCH) {\n  results.push({ json: { rows: transformed.slice(i, i + BATCH), total_rows: transformed.length } });\n}\nif (results.length === 0) results.push({ json: { rows: [], total_rows: 0 } });\nreturn results;"
      }
    },
    {
      "id": "aaaaaaaa-0011-0011-0011-000000000005",
      "name": "Transform GA Source",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        400
      ],
      "parameters": {
        "jsCode": "function serialToISODate(serial) {\n  const epochMs = Date.UTC(1899, 11, 30);\n  return new Date(epochMs + serial * 86400000).toISOString().slice(0, 10);\n}\n\nconst resp = $input.first().json;\nconst rows = (resp.values || []).slice(1);\nconst transformed = [];\n\nfor (const r0 of rows) {\n  const r = r0.map(v => v === '' ? null : v);\n  const [dateSerial, sourceMedium, sessions, totalUsers, conversions, engagementRate, engagedSessions, beginCheckoutCount] = r;\n  if (dateSerial == null || !sourceMedium) continue;\n  transformed.push({\n    date: serialToISODate(dateSerial),\n    source_medium: sourceMedium,\n    sessions: sessions ?? null,\n    total_users: totalUsers ?? null,\n    conversions: conversions ?? null,\n    engagement_rate: engagementRate ?? null,\n    engaged_sessions: engagedSessions ?? null,\n    begin_checkout_count: beginCheckoutCount ?? null,\n    synced_at: new Date().toISOString(),\n  });\n}\n\nconst BATCH = 100;\nconst results = [];\nfor (let i = 0; i < transformed.length; i += BATCH) {\n  results.push({ json: { rows: transformed.slice(i, i + BATCH), total_rows: transformed.length } });\n}\nif (results.length === 0) results.push({ json: { rows: [], total_rows: 0 } });\nreturn results;"
      }
    },
    {
      "id": "aaaaaaaa-0011-0011-0011-000000000006",
      "name": "Transform GA Geo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        600
      ],
      "parameters": {
        "jsCode": "function serialToISODate(serial) {\n  const epochMs = Date.UTC(1899, 11, 30);\n  return new Date(epochMs + serial * 86400000).toISOString().slice(0, 10);\n}\n\nconst resp = $input.first().json;\nconst rows = (resp.values || []).slice(1);\nconst transformed = [];\n\nfor (const r0 of rows) {\n  const r = r0.map(v => v === '' ? null : v);\n  const [dateSerial, city, region, country, sessions, totalUsers, newUsers, conversions, userConversionRate, beginCheckoutCount] = r;\n  if (dateSerial == null || !city) continue;\n  transformed.push({\n    date: serialToISODate(dateSerial),\n    city: city,\n    region: region ?? null,\n    country: country ?? null,\n    sessions: sessions ?? null,\n    total_users: totalUsers ?? null,\n    new_users: newUsers ?? null,\n    conversions: conversions ?? null,\n    user_conversion_rate: userConversionRate ?? null,\n    begin_checkout_count: beginCheckoutCount ?? null,\n    synced_at: new Date().toISOString(),\n  });\n}\n\nconst BATCH = 100;\nconst results = [];\nfor (let i = 0; i < transformed.length; i += BATCH) {\n  results.push({ json: { rows: transformed.slice(i, i + BATCH), total_rows: transformed.length } });\n}\nif (results.length === 0) results.push({ json: { rows: [], total_rows: 0 } });\nreturn results;"
      }
